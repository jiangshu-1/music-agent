LLM_PROVIDER=9router
LLM_FALLBACK_PROVIDER=deepseek
# Logging: LOG_LEVEL defaults to info; LOG_FORMAT defaults to text, set json for structured logs.
LOG_LEVEL=info
LOG_FORMAT=text
# Optional data directory override; empty uses ./data/state.db.
CIKE_DATA_DIR=
# Resilience defaults for external clients.
LLM_TIMEOUT_MS=10000
LLM_RETRIES=2
LLM_BREAKER_THRESHOLD=5
LLM_BREAKER_COOLDOWN_MS=30000
TTS_TIMEOUT_MS=15000
TTS_RETRIES=2
TTS_BREAKER_THRESHOLD=5
TTS_BREAKER_COOLDOWN_MS=30000
NETEASE_TIMEOUT_MS=8000
NETEASE_RETRIES=2
NETEASE_BREAKER_THRESHOLD=5
NETEASE_BREAKER_COOLDOWN_MS=30000
NINEROUTER_BASE_URL=http://127.0.0.1:20128/v1
NINEROUTER_API_KEY=
NINEROUTER_MODEL=kr/claude-sonnet-4.5
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
FISH_API_KEY=
FISH_MODEL=s2-pro
FISH_USER_ID=self
FISH_TEAM_ID=
FISH_REFERENCE_ID=
FISH_SPEED=1
FISH_VOLUME=0
FISH_TEMPERATURE=0.7
FISH_TOP_P=0.7
FISH_LATENCY=normal
FISH_CHUNK_LENGTH=300
FISH_SAMPLE_RATE=44100
FISH_MP3_BITRATE=128
FISH_MAX_NEW_TOKENS=1024
FISH_REPETITION_PENALTY=1.2
FISH_MIN_CHUNK_LENGTH=50
FISH_EARLY_STOP_THRESHOLD=1
NETEASE_API_BASE=http://127.0.0.1:3000
NETEASE_LEVEL=exhigh
NETEASE_USER_ID=
NETEASE_COOKIE=
NETEASE_REAL_IP=
